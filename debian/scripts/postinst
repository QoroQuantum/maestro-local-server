#!/bin/sh

deb-systemd-helper unmask maestro.service > /dev/null || true

if deb-systemd-helper --quiet was-enabled maestro.service
then
    deb-systemd-helper enable maestro.service > /dev/null || true
    deb-systemd-invoke start maestro-local-server
else
    deb-systemd-helper update-state maestro.service > /dev/null || true
fi